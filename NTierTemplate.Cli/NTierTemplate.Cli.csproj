<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.18" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.18" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.18" />
        <PackageReference Include="System.CommandLine" Version="2.0.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NTierTemplate\NTierTemplate.csproj" />
        <ProjectReference Include="..\NTierTemplate.Application\NTierTemplate.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="clisettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="example.clisettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
